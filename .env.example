# Образец .env для production (рядом с docker-compose.yml). Скопировать в .env, заполнить, chmod 600.
# .env не хранится в git и не попадает в образ (.dockerignore); docker-compose передаёт его в контейнер server
# (env_file), а robotom/robotom/settings.py читает значения из окружения.
#
# Перенос секретов из старого (не из git) settings.py: python3 tools/settings_to_env.py <старый settings.py> >> .env
# Формат строк — KEY=value, без кавычек и пробелов вокруг «=».

# --- обязательно ------------------------------------------------------------------------------------------------

# Секрет Django (подписи сессий, CSRF, ссылок сброса пароля). Смена — все пользователи разлогинятся.
# Новый: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Пароль почтового ящика для писем активации (для Gmail — пароль приложения)
EMAIL_HOST_PASSWORD=

# Общий секрет rbtm-web и recon-service (студия реконструкции) — ТОТ ЖЕ, что в rbtm-recon/web/.env.
# Новый: python3 -c "import secrets; print(secrets.token_urlsafe(32))" — и записать в оба файла.
# Пустой — прокси студии отвечает 503.
RECON_TOKEN=

# --- необязательно: переопределить умолчания settings.py ----------------------------------------------------------
# Списки — через запятую.

# ALLOWED_HOSTS=109.234.38.83,tomox.ru,www.tomox.ru,localhost,nanotom,10.0.7.153
# CSRF_TRUSTED_ORIGINS=http://109.234.38.83,https://109.234.38.83,http://tomox.ru,https://tomox.ru,https://www.tomox.ru,http://localhost:5080,http://localhost
# EXPERIMENT_HOST=http://10.0.6.86:5001/
# STORAGE_HOST=http://rbtmstorage_server_1:5006/
# STORAGE_PUBLIC_HOST=
# RECONSTRUCTION_HOST=http://10.0.7.153:5550/
# RECON_SERVICE_URL=http://web_reconstructor_1:5560/
# DB_HOST=database
# DB_NAME=robotom_users
# DB_USER=postgres
# DB_PASSWORD=postgres
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=robotomproject@gmail.com
# DEFAULT_FROM_EMAIL=robotomproject@gmail.com
# DJANGO_DEBUG=false
